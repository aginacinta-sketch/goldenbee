# ==============================================================
# Contoh environment — salin menjadi ".env" lalu sesuaikan path.
#     cp .env.example .env
# ==============================================================

# WAJIB — lokasi database SQLite (file tunggal berisi SEMUA data:
# produk, pengaturan, gambar/video base64, pesan chat, kontak).
#
# ATURAN:
#  1. Gunakan PATH ABSOLUT di produksi (paling aman, bebas salah cwd).
#  2. Folder db/ harus BISA DITULIS oleh proses server (WAL/ShM).
#  3. Jangan mengosongkan variabel ini — tanpa DATABASE_URL semua
#     query gagal dan website hanya menampilkan spinner (kasus Task 68).
#
# Contoh sandbox (dev):
# DATABASE_URL=file:/home/z/my-project/db/custom.db
#
# Contoh VPS (panduan: PANDUAN-HOSTING.md):
DATABASE_URL=file:/opt/b2b-katalog/db/custom.db

# Opsional — port aplikasi (dipakai server standalone saat produksi)
# PORT=3000
